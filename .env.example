# ── Telegram ───────────────────────────────────────────────────────────────────
# Get token from @BotFather
BOT_TOKEN=
BOT_NAME=nullwatch-bot

# ── LLM backend ────────────────────────────────────────────────────────────────
# "nullclaw" = route through nullclaw gateway (recommended, enables observability)
# "ollama"   = call ollama directly (simpler, no agent memory)
LLM_BACKEND=nullclaw

# ── Model ──────────────────────────────────────────────────────────────────────
# Must be available in ollama. Will be pulled automatically on first 'docker compose up'.
OLLAMA_MODEL=qwen3:8b

# ── nullclaw auth ──────────────────────────────────────────────────────────────
# Leave empty when require_pairing=false in docker/nullclaw-home/config.json (default).
NULLCLAW_PAIRING_CODE=
NULLCLAW_BEARER_TOKEN=
NULLCLAW_CHANNEL=nullwatch-bot
NULLCLAW_TIMEOUT_SECS=180
NULLCLAW_FOLLOWUP_TIMEOUT_SECS=600
NULLCLAW_FOLLOWUP_POLL_SECS=3

# ── Tool grounding scorer ──────────────────────────────────────────────────────
# "llm" = LLM judge (better, uses extra inference time)
# "keyword" = fast heuristic, zero extra calls
TOOL_GROUNDING_BACKEND=llm
TOOL_GROUNDING_MODEL=qwen3:8b

# ── Service URLs ───────────────────────────────────────────────────────────────
# When running via Docker Compose these are automatically overridden to use
# service names (nullwatch, nullclaw, ollama). Only change these for local runs.
NULLWATCH_URL=http://127.0.0.1:7710
NULLCLAW_URL=http://127.0.0.1:3000
OLLAMA_URL=http://127.0.0.1:11434
TOOL_GROUNDING_LLM_URL=http://127.0.0.1:11434/v1
